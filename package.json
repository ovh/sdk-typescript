{
  "name": "@ovhcloud/sdk",
  "version": "0.3.0",
  "description": "TypeScript client for the OVHcloud API",
  "keywords": [
    "ovh",
    "ovhcloud",
    "api",
    "sdk",
    "cloud"
  ],
  "license": "Apache-2.0",
  "author": "OVH SAS",
  "homepage": "https://github.com/ovh/sdk-typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ovh/sdk-typescript.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./api/*": {
      "types": "./dist/api/*/index.d.ts",
      "default": "./dist/api/*/index.js"
    },
    "./llms.txt": "./llms.txt",
    "./AGENTS.md": "./AGENTS.md",
    "./index/*": "./index/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/core",
    "index",
    "examples",
    "llms.txt",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build-types.json && tsc -p tsconfig.build-core.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "22.20.5"
  }
}
